# Copier en .env et renseigner. NE JAMAIS committer le .env.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Cle service_role : contourne la RLS. A garder EXCLUSIVEMENT ici, cote serveur.
# Ne jamais la mettre dans config.js ni dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

